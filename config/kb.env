# Knowledge base root path.
KB_ROOT="/Users/davidz/2026 金融分析知识库"

# Default filename date prefix. Supported values:
# - today: use current local date
# - none: do not prepend a date
KB_DATE_MODE="today"

# Optional fixed date override in YYYY-MM-DD format.
# This is useful when the local shell clock differs from the working date.
KB_FORCE_DATE="2026-08-06"

# Timezone used for automatic date prefixes.
KB_TIMEZONE="America/Los_Angeles"

# Save log path.
KB_LOG_FILE="$KB_ROOT/logs/save.log"
